# MISSIONWISE AI — Environment Configuration
# Copy to .env and fill in secrets before running. Never commit .env.

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=missionwise
POSTGRES_PASSWORD=missionwise_dev_password
POSTGRES_DB=missionwise
DATABASE_URL=postgresql+psycopg://missionwise:missionwise_dev_password@localhost:5432/missionwise

# LLM Configuration (provider-agnostic LLMClient)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=45

# Embeddings & Reranker (HuggingFace / sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKER_MODEL=BAAI/bge-reranker-base
MODEL_CACHE_DIR=/app/model_cache

# Retrieval & Abstention Thresholds
RETRIEVAL_TOP_K_DENSE=25
RETRIEVAL_TOP_K_BM25=25
RETRIEVAL_TOP_K_RERANK=6
MIN_RERANK_SCORE_THRESHOLD=0.18
MIN_RRF_SCORE_THRESHOLD=0.012
MAX_UPLOAD_MB=100

# STAIR Section Selection & Evaluation
SECTION_SELECTOR_MODE=auto
STAIR_TOP_K_SECTIONS=6
STAIR_LORA_ADAPTER_PATH=
STAIR_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Voice (Sarvam AI primary STT/TTS + faster-whisper / Piper fallback)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v1
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_SPEAKER=meera
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ENABLE_SERVER_STT=true
PIPER_VOICE_PATH=

# Security & Auth
JWT_SECRET_KEY=change-me-in-production-32-chars-min
JWT_EXPIRE_MINUTES=720
AUTH_REQUIRED=false
SEED_DEMO_USERS=true
DEMO_ADMIN_PASSWORD=Admin!Mission2026
DEMO_ENGINEER_PASSWORD=Engineer!Mission2026
RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=40
MAX_UPLOAD_PAGES=800
PREWARM_MODELS=true
DEMO_CACHE_PATH=../data/demo/demo_cache.json
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000
